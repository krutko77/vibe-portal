# VibeCode API
# Получить ключ: https://vibecode.bitrix24.tech → Ключи API → Создать
VIBE_API_KEY=vibe_api_YOUR_KEY_HERE
VIBE_BASE_URL=https://vibecode.bitrix24.tech/v1

# Сервер Vibecode (заполняется после первого деплоя)
# Создать сервер: POST /v1/infra/servers
SERVER_ID=

# Приложение
PORT=3000
NODE_ENV=production
